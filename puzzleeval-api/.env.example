# =========================================================================
# PuzzleEval — Environment Variables Template
# =========================================================================
# Copy this file to `.env` and fill in the keys you have. Every key is
# OPTIONAL except the first one — PuzzleEval is designed to degrade
# gracefully when a credential is missing (the affected plugin returns a
# structured "no provider" fallback; the LLM judge takes over).
#
# AFTER EDITING:  there are no manual steps. Both the FastAPI backend
# (`uvicorn main:app`) and the CLI (`python -m puzzleeval.cli ...`) load
# this file automatically at startup.
#
# THREE SURFACES FOR CREDENTIALS:
#   1. THIS FILE          → system-level keys (the agents themselves +
#                           plugin providers like OpenAI Whisper, ElevenLabs)
#   2. provider_registry.json → candidate API keys for the things being
#                           TESTED (Mindee, Veryfi, Stripe, etc.) — see that
#                           file's schema for OAuth + per-provider tier info
#   3. os.environ         → anything from this file can also be set as a
#                           shell env var; shell vars OVERRIDE this file
# =========================================================================


# -------------------------------------------------------------------------
# REQUIRED — Anthropic Claude API key (the agents themselves run on this)
# -------------------------------------------------------------------------
# Get a key at: https://console.anthropic.com/
# Format: starts with "sk-ant-"
# Cost:  Agent pipeline runs ~$5-7 total per evaluation (Sonnet+Opus mix)
ANTHROPIC_API_KEY=


# -------------------------------------------------------------------------
# Provider registry (candidate API keys for things being tested)
# -------------------------------------------------------------------------
# Absolute path to the JSON file containing test-target API credentials.
# Defaults to the bundled provider_registry.json next to the puzzleeval
# package. Override only if you keep the registry elsewhere.
PUZZLEEVAL_PROVIDER_REGISTRY=


# =========================================================================
# PLUGIN PROVIDER KEYS  (any subset; missing = LLM judge fallback)
# =========================================================================
# These power the cross-modality tool plugins (transcription, TTS, vision,
# code execution, conversation simulator). Each plugin checks its required
# credentials at startup and reports readiness via the CLI status table:
#
#     python -c "from puzzleeval.plugin_status import snapshot_all, format_text_table; print(format_text_table(snapshot_all()))"
#
# Pricing notes are approximate (2026-04). Free tiers cover typical
# evaluation volumes; upgrade only if you run dozens of pipelines/day.
# =========================================================================


# -------------------------------------------------------------------------
# Speech-to-Text providers (transcription plugin — voice agent evaluation)
# -------------------------------------------------------------------------
# ANY ONE of these enables the transcription plugin. The plugin auto-picks
# the first available, or you can force one via PUZZLEEVAL_STT_PROVIDER.
# Used for: voice/phone agents (STTs the agent's audio response back to
# text for comparison against the expected transcript).

# OpenAI Whisper — get a key at https://platform.openai.com/
# Cost: ~$0.006/min of audio; 25MB file size limit per request
OPENAI_API_KEY=

# Deepgram — get a key at https://console.deepgram.com/
# Free tier: ~12,000 minutes/year; very fast; supports diarization
DEEPGRAM_API_KEY=

# AssemblyAI — get a key at https://www.assemblyai.com/
# Free tier: ~5 hours/month; supports speaker labels + sentiment
ASSEMBLYAI_API_KEY=

# Optional: force a specific STT provider (otherwise first available wins)
# PUZZLEEVAL_STT_PROVIDER=openai_whisper


# -------------------------------------------------------------------------
# Text-to-Speech providers (tts plugin — synthesizes audio test inputs)
# -------------------------------------------------------------------------
# Used for: voice agents that need realistic audio inputs when the user
# hasn't uploaded sample recordings. The plugin synthesizes audio from
# Agent 3's text-described test cases.
#
# ANY ONE enables. OPENAI_API_KEY (above) ALSO enables OpenAI tts-1.

# ElevenLabs — get a key at https://elevenlabs.io/
# Free tier: ~10,000 chars/month; highest-quality voices
ELEVENLABS_API_KEY=

# Optional: force a specific TTS provider
# PUZZLEEVAL_TTS_PROVIDER=openai_tts

# Optional: ElevenLabs voice ID (defaults to "Rachel")
# PUZZLEEVAL_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM


# =========================================================================
# DIAGNOSTIC FLAGS (advanced — leave unset for default behavior)
# =========================================================================

# Disable the cross-run memory cache (re-research every provider every run)
# PUZZLEEVAL_MEMORY_ENABLED=0

# Override the memdir storage location
# PUZZLEEVAL_MEMDIR=/path/to/memdir

# How long an atlas memo stays fresh before re-research (default 14 days)
# PUZZLEEVAL_DEEP_VERIFY_MEMO_MAX_AGE_DAYS=14

# Disable Phase 6.5 deep-verify (revert to legacy shallow PASS/REJECT)
# PUZZLEEVAL_AGENT4_DEEP_VERIFY_ENABLED=0

# Disable adversarial verification probes (smoke-test only)
# PUZZLEEVAL_ADVERSARIAL_PROBES_ENABLED=0

# Disable Agent 5 fallback to next-ranked candidates on total build failure
# PUZZLEEVAL_AGENT5_FALLBACK_ENABLED=0

# Disable rate limiting (tests run as fast as possible)
# PUZZLEEVAL_RATE_LIMIT_ENABLED=0

# Override timeouts for long-running APIs (video, ML training, batch)
# PUZZLEEVAL_AGENT5_CODE_TIMEOUT_LONG=600
# PUZZLEEVAL_AGENT6_TEST_TIMEOUT_LONG=600


# =========================================================================
# PRODUCTION KNOBS — cost, resilience, and reasoning tuning
# =========================================================================
# Full reference with defaults: puzzleeval-api/BACKEND_ARCHITECTURE.md §19

# ── Cost circuit-breaker ────────────────────────────────────────────────
# Hard USD cap per run. Crossing it raises BudgetExceededError, which
# surfaces as HTTP 402 at /chat and as pipeline_failed (reason=
# "budget_exceeded") at the pipeline boundary. Raise for real Agent 5 runs
# against expensive providers; LOWER during development.
# PUZZLEEVAL_MAX_RUN_COST_USD=25.0

# ── Anthropic client tuning ─────────────────────────────────────────────
# Default 120 s covers deep thinking without hanging the pipeline for
# 10 min on a stalled TCP socket. max_retries handles transient 5xx /
# connection drops at the SDK level.
# PUZZLEEVAL_ANTHROPIC_TIMEOUT_S=120
# PUZZLEEVAL_ANTHROPIC_MAX_RETRIES=3

# ── Model selection ─────────────────────────────────────────────────────
# Override any of these to pin specific models per agent.
# PUZZLEEVAL_MODEL=claude-sonnet-4-6
# PUZZLEEVAL_AGENT1_MODEL=claude-opus-4-7
# PUZZLEEVAL_RESEARCH_MODEL=claude-sonnet-4-6
# PUZZLEEVAL_SCREENING_MODEL=claude-sonnet-4-6
# PUZZLEEVAL_BUILDER_MODEL=claude-opus-4-7

# ── Adaptive-thinking effort tier ───────────────────────────────────────
# low / medium / high (default) / xhigh / max — soft guidance to Claude on
# how much to think per request. xhigh / max = deeper planning, higher
# latency + cost. Applies to every agent running with thinking=adaptive.
# PUZZLEEVAL_EFFORT=high

# ── Agent 5 feature flags ───────────────────────────────────────────────
# Hybrid evaluator: when deterministic modality dispatch yields no plugin,
# expose all plugins as Claude-callable tools and let it pick one.
# PUZZLEEVAL_HYBRID_EVAL_ENABLED=0

# Programmatic tool calling: Agent 5 builder writes Python that chains
# tool calls in one container (~30-50% savings on multi-step builds).
# PUZZLEEVAL_PROGRAMMATIC_TOOLS_ENABLED=0

# Fallback to next-ranked candidates when all primary picks fail to build.
# PUZZLEEVAL_AGENT5_FALLBACK_ENABLED=1
# PUZZLEEVAL_AGENT5_FALLBACK_MAX=3

# ── Uploads + test-data sufficiency ─────────────────────────────────────
# Per-file upload cap in bytes (default 100 MiB). HTTP 413 on overflow.
# PUZZLEEVAL_MAX_UPLOAD_BYTES=104857600

# Thresholds used by the sufficiency analyzer when deciding READY /
# AUGMENT / REQUEST_MORE / DEGRADE per scope.
# PUZZLEEVAL_MIN_FILES_PER_SCOPE=3
# PUZZLEEVAL_IDEAL_FILES_PER_SCOPE=6

# ── Plugin registry strictness ──────────────────────────────────────────
# Default: warn on duplicate plugin names. Set to 1 to raise instead.
# PUZZLEEVAL_STRICT_PLUGIN_REGISTRY=0

# ── Local plugin port + bind overrides ──────────────────────────────────
# Change only if a default port conflicts with something else on your host.
# webhook_receiver
# PUZZLEEVAL_WEBHOOK_PORT=8765
# PUZZLEEVAL_WEBHOOK_BIND=127.0.0.1
# PUZZLEEVAL_WEBHOOK_MAX_BODY=1048576
# PUZZLEEVAL_TUNNEL_URL=                                   # optional ngrok/cloudflared public URL

# outbound_delivery (SMTP + channel HTTP + SMS HTTP)
# PUZZLEEVAL_SMTP_PORT=2525
# PUZZLEEVAL_SMTP_BIND=127.0.0.1
# PUZZLEEVAL_SMTP_MAX_LINE_BYTES=8192
# PUZZLEEVAL_SMTP_MAX_DATA_BYTES=26214400
# PUZZLEEVAL_SLACK_MOCK_PORT=8766
# PUZZLEEVAL_SMS_MOCK_PORT=8767
# PUZZLEEVAL_OUTBOUND_BIND=127.0.0.1
# PUZZLEEVAL_OUTBOUND_HTTP_MAX_BODY=1048576

# voice_realtime
# PUZZLEEVAL_VOICE_PORT=8768
# PUZZLEEVAL_VOICE_BIND=127.0.0.1
# PUZZLEEVAL_VOICE_MAX_AUDIO=26214400

# ── Billing gate ────────────────────────────────────────────────────────
# Service-tier enforcement for paid/enterprise runs. Default 0 = every
# agent runs regardless of plan.
# PUZZLEEVAL_BILLING_ENFORCED=0

# ── Phase flags (all shipped; leave unset for default-on behavior) ──────
# PUZZLEEVAL_USER_SELECTION_ENABLED=1                      # Phase 6 SelectionPanel gate
# PUZZLEEVAL_RESEARCH_DUAL_SEARCH_ENABLED=1                # Phase 4 per-scope + survey
# PUZZLEEVAL_SCOPE_TEST_MODE=per_scope                     # Phase 7 per-scope top-K


# =========================================================================
# FRONTEND (Vite dev server) — not used by the backend
# =========================================================================
# Retarget the SPA at a different backend URL without rebuilding. Defaults
# to /pzapi (the dev-proxy mount in vite.config.ts).
# VITE_API_BASE=/pzapi
